<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="details">
		<field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" readonly="true" class="readonly" />

		<field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" />

		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" hint="JFIELD_ALIAS_PLACEHOLDER" />

		<field name="description" type="editor" label="COM_ADRIANJDOWNLOADS_FIELD_DESCRIPTION_LABEL" filter="JComponentHelper::filterText" buttons="true" />

		<field name="upload_file" type="file" label="COM_ADRIANJDOWNLOADS_FIELD_UPLOAD_LABEL" description="COM_ADRIANJDOWNLOADS_FIELD_UPLOAD_DESC" />

		<field name="remove_file" type="checkbox" label="COM_ADRIANJDOWNLOADS_FIELD_REMOVE_FILE_LABEL" value="1" filter="integer" />

		<field name="external_url" type="url" label="COM_ADRIANJDOWNLOADS_FIELD_EXTERNAL_URL_LABEL" description="COM_ADRIANJDOWNLOADS_FIELD_EXTERNAL_URL_DESC" filter="url" validate="url" maxlength="2048" />

		<field name="version" type="text" label="COM_ADRIANJDOWNLOADS_FIELD_VERSION_LABEL" maxlength="50" />

		<field name="author" type="text" label="COM_ADRIANJDOWNLOADS_FIELD_AUTHOR_LABEL" maxlength="255" />
	</fieldset>

	<fieldset name="sidebar">
		<field name="state" type="list" label="JSTATUS" class="form-select-color-state" default="1" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>

		<field name="catid" type="category" label="JCATEGORY" extension="com_adrianjdownloads" required="true" addfieldprefix="Joomla\Component\Categories\Administrator\Field" />

		<field name="access" type="accesslevel" label="COM_ADRIANJDOWNLOADS_FIELD_ACCESS_VIEW_LABEL" description="COM_ADRIANJDOWNLOADS_FIELD_ACCESS_VIEW_DESC" filter="UINT" validate="options" />

		<field name="require_login" type="radio" label="COM_ADRIANJDOWNLOADS_FIELD_REQUIRE_LOGIN_LABEL" description="COM_ADRIANJDOWNLOADS_FIELD_REQUIRE_LOGIN_DESC" layout="joomla.form.field.radio.switcher" default="0" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL">
			<option value="*">JALL</option>
		</field>
	</fieldset>

	<fieldset name="publishing">
		<field name="publish_up" type="calendar" label="COM_ADRIANJDOWNLOADS_FIELD_PUBLISH_UP_LABEL" translateformat="true" showtime="true" filter="user_utc" />

		<field name="publish_down" type="calendar" label="COM_ADRIANJDOWNLOADS_FIELD_PUBLISH_DOWN_LABEL" translateformat="true" showtime="true" filter="user_utc" />

		<field name="created" type="calendar" label="COM_ADRIANJDOWNLOADS_FIELD_CREATED_LABEL" translateformat="true" showtime="true" filter="user_utc" />

		<field name="created_by" type="user" label="COM_ADRIANJDOWNLOADS_FIELD_CREATED_BY_LABEL" validate="UserId" />

		<field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL" class="readonly" readonly="true" translateformat="true" showtime="true" filter="user_utc" />

		<field name="downloads" type="number" label="COM_ADRIANJDOWNLOADS_FIELD_DOWNLOADS_LABEL" class="readonly" readonly="true" filter="unset" />

		<field name="hits" type="number" label="JGLOBAL_HITS" class="readonly" readonly="true" filter="unset" />

		<field name="ordering" type="hidden" filter="unset" />
		<field name="checked_out" type="hidden" filter="unset" />
		<field name="checked_out_time" type="hidden" filter="unset" />
	</fieldset>
</form>
